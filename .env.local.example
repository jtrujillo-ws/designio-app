# ── Datos ────────────────────────────────────────────────────────────────────
# Conexión ADMIN (migraciones y seed; superusuario local). En nube: Cloud SQL vía Secret Manager.
DATABASE_URL=postgres://postgres:postgres@localhost:54322/postgres
# Conexión de la APLICACIÓN (rol no privilegiado, RLS activo). El rol lo crea el
# bootstrap de db/migrate.ts (APP_DB_PASSWORD; default solo-desarrollo).
DATABASE_URL_APP=postgres://designio_app:designio_app_dev@localhost:54322/postgres
# Password del rol de aplicación en el bootstrap. OBLIGATORIA en producción
# (con NODE_ENV=production y sin esta variable, las migraciones abortan).
APP_DB_PASSWORD=

# ── Firma ────────────────────────────────────────────────────────────────────
# Genera uno local: openssl rand -hex 32   (sesiones, recovery y tokens de capacidad)
JWT_SECRET=

# ── AI (SDK de Anthropic) ────────────────────────────────────────────────────
# Fallback del entorno; los workspaces pueden traer su propia key (BYOAI).
ANTHROPIC_API_KEY=

# ── Correo (no-op con logging si está vacío) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=http://localhost:5173

# ── Crons / jobs ─────────────────────────────────────────────────────────────
CRON_SECRET=

# ── Solo desarrollo ──────────────────────────────────────────────────────────
SEED_ON_START=false
